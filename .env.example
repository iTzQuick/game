# Copia questo file in .env.local e inserisci i dati del tuo progetto Supabase
# (Project Settings → API). La chiave "anon"/"publishable" è pubblica per natura:
# non mettere MAI qui la service_role key o la chiave API di Anthropic.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Facoltativo: server TURN per le reti che bloccano il peer-to-peer (es. alcune 4G/5G).
# Senza TURN, chi non riesce a collegarsi in P2P passa sul relay di Supabase a frequenza ridotta.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
